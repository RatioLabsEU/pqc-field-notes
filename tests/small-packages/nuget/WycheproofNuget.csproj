<Project Sdk="Microsoft.NET.Sdk">
  <!-- Wycheproof vectors against KyberNET (NuGet package with its own ML-KEM).
       Version pinned with [x] so that the log says exactly what was tested; it can be changed with
       -p:KyberNetVersion=...  Target net10.0 (KyberNET ships its own assembly for net10.0).
       Copyright 2026 RatioLabs (https://www.ratiolabs.eu). Licensed under the Apache License, Version 2.0. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <KyberNetVersion Condition="'$(KyberNetVersion)' == ''">1.0.3</KyberNetVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="KyberNET" Version="[$(KyberNetVersion)]" />
  </ItemGroup>
</Project>
